# Copy this to .env and fill in your real keys
# Do NOT commit .env — it's in .gitignore

# Figma design integration
FIGMA_ACCESS_TOKEN=

# Sanity CMS (get from https://www.sanity.io/manage)
# SANITY_API_READ_TOKEN — server-only, never prefix with NEXT_PUBLIC_
SANITY_API_READ_TOKEN=
# SANITY_API_WRITE_TOKEN — Editor token; webhook ticket persistence only
SANITY_API_WRITE_TOKEN=

# Sanity project — these are safe to expose (NEXT_PUBLIC_)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_WEBHOOK_SECRET=

# Netlify — REQUIRED for on-demand revalidation to purge the CDN cache
# (site-scoped or personal access token; without it, Sanity publishes
# revalidate the origin but clubbassment.com serves stale pages until the
# ISR timer expires)
NETLIFY_PURGE_API_TOKEN=

# Stripe (use TEST keys locally, LIVE keys in production env only)
# Publishable key is safe to expose (NEXT_PUBLIC_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Maps (restrict by HTTP referrer in Google Cloud Console)
# Note: the Maps JavaScript API key IS exposed client-side via <script> tag.
# Mitigate with HTTP referrer restrictions in GCP console, not by hiding it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Resend (email)
RESEND_API_KEY=
# e.g. "BASSMENT <tickets@contact.clubbassment.com>" — REQUIRED in production
# (throws without it there; dev falls back to the Resend onboarding address)
RESEND_FROM_EMAIL=
RESEND_CONTACT_EMAIL=

# Testing — pnpm test:integration (must be the Resend account owner while
# the sender is the onboarding address)
TEST_TICKET_EMAIL=
