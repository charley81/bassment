# Copy this to .env and fill in your real keys
# Do NOT commit .env — it's in .gitignore

# Figma design integration
FIGMA_ACCESS_TOKEN=

# Sanity CMS (get from https://www.sanity.io/manage)
# SANITY_API_READ_TOKEN — server-only, never prefix with NEXT_PUBLIC_
SANITY_API_READ_TOKEN=

# Sanity project — these are safe to expose (NEXT_PUBLIC_)
NEXT_PUBLIC_SANITY_PROJECT_ID=cp66glrr
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_WEBHOOK_SECRET=

# Google Maps (restrict by HTTP referrer in Google Cloud Console)
# Note: the Maps JavaScript API key IS exposed client-side via <script> tag.
# Mitigate with HTTP referrer restrictions in GCP console, not by hiding it.
GOOGLE_MAPS_API_KEY=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_CONTACT_EMAIL=

# Ticket Fairy
TICKET_FAIRY_API_KEY=
